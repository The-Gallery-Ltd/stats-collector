{
    "name": "The-Gallery-Ltd/stats-collector",
    "description": "Per-site request collector for the self-hosted stats service: records every request that reaches Laravel and ships it to the central stats app.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Secarma\\StatsCollector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Secarma\\StatsCollector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Secarma\\StatsCollector\\StatsCollectorServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
